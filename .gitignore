# Release binaries staged for App Store upload. Half a gigabyte of .ipa per
# release round — build output, never source. Regenerate with
# tools/build_all_ipa.sh.
ipa_staging/

# Per-app build output. Every app is its own Flutter project now, so these
# live under <App>/build/ as well as the repo-root build/ the release
# scripts write IPAs and AABs into.
build/
*/build/
*/.dart_tool/
*/ios/Pods/
*/ios/.symlinks/
*/ios/Flutter/Generated.xcconfig
*/ios/Flutter/flutter_export_environment.sh
*/macos/Pods/
*/macos/Flutter/ephemeral/
*/android/.gradle/
*/android/local.properties
*/android/key.properties
.DS_Store

# python bytecode from tools/
__pycache__/
*.pyc

# Local UI-walk output from tools/drive_app.sh (per-app; the hub keeps its
# own committed screenshots/, which the script no longer touches).
*Board/screenshots/
tactics_board/screenshots/0[0-9]-*.png
board_png/
# Page shots from tool/shoot_pages.dart — a look at the UI, not source.
page_png/

# Generated by tactics_board/tool/render_thumbs.dart — the thumbnail sheet
# renders 624 PNGs from the drill data; regenerate rather than commit them.
thumb_png/

# App Store 上架截图：16 app × 11 语言 × 6 幕 = 1056 张成品 PNG。合成产物，
# 不是源 —— 由 tactics_board/tool/aso_design_compositor.py --all 生成并回写，
# upload_screenshots.py 只读磁盘上的这些目录。新克隆的仓库里没有它们，
# 上传前必须先跑一遍合成。（原始素材：aso/glyphs/、aso/captions_v2.*、
# integration_test/appstore_screenshots.dart，这些都在版本控制里。）
*/fastlane/screenshots/
