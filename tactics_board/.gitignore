**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Native splash + icon artifacts ARE committed now (2026-09-03). They used to
# be ignored because every `tool/build_sport.sh <sport>` run regenerated them
# in place, so tracking them risked committing one sport's splash as another's
# — which is exactly what happened (this project shipped footvolley's icon as
# the hub's). Each app owns its own copy today and nothing regenerates them,
# so they must be tracked. Regenerate deliberately with
# `dart run flutter_launcher_icons && dart run flutter_native_splash:create`.

# fastlane lane run output (transient test report)
tool/app_privacy/fastlane/report.xml

# v2 screenshot throwaway previews
aso/sample_v2/
aso/design_sample_badminton_s1.png
