  "learn_primer_title": "How to read a drill board",
  "learn_primer_sub": "What the ghosts, rings and dashed lines mean",
  "learn_primer_intro": "Every drill in the library is a board you can step through. These are the marks it uses.",
  "learn_run_title": "A player's run",
  "learn_run_1": "Solid token — where he is at the step you are on.",
  "learn_run_2": "Faded token — the other end of his run: where he set off from, or where he is going.",
  "learn_run_3": "Small hollow ring — a stop along the way, not an object on the pitch.",
  "learn_run_4": "Short arrow, one token — a shift too small to draw as a move; it shows the direction only.",
  "learn_ball_title": "The ball",
  "learn_ball_1": "Beside a player, not on him — that is possession; the offset keeps his number readable.",
  "learn_ball_2": "A dashed line of its own — the ball travelled alone: a pass, a shot, a serve.",
  "learn_ball_3": "No line of its own — it was carried, and the player's arrow is the whole story.",
